# RssEnhancer settings for the subscription processor (mail) and the publisher.
# The feed hydrator is configured in config.json instead (see config.example.json).
# Copy to .env and fill in:  cp env.example .env && chmod 600 .env
# (this template has no leading dot so Finder shows it; .env itself is hidden and git-ignored)
# Real environment variables override values in this file. To read a different file,
# set RSSENHANCER_ENV=/path/to/file in the real environment.

# ---------------------------------------------------------------- subscription processor: mailbox
# Uncomment SUBSCRIPTION_ADDRESS (and set IMAP_PASSWORD) to enable the mail source;
# without it only the feed hydrator runs.
# The plus address you signed up to newsletters with. Only mail addressed to
# exactly this address is processed (foo@baz.com and foo+other@baz.com are ignored).
#SUBSCRIPTION_ADDRESS=foo+bar@baz.com
# App password (Gmail: Google Account -> Security -> 2-Step Verification -> App passwords)
IMAP_PASSWORD=

# (optional mailbox settings)
#IMAP_HOST=imap.gmail.com
# Defaults to SUBSCRIPTION_ADDRESS without the +tag
#IMAP_USER=foo@baz.com
# Gmail: use "[Gmail]/All Mail" if a filter skips the inbox
#IMAP_FOLDER=INBOX
# How often to check for mail, and how far back the search looks
#SUBSCRIPTION_POLL_MINUTES=15
#SUBSCRIPTION_LOOKBACK_DAYS=7

# ---------------------------------------------------------------- publisher / hosting (serves every feed)
# Falls back to $PORT, which most hosting platforms set
#RSSENHANCER_PORT=8787
# Bind address. Use 0.0.0.0 on a server/PaaS. There is no HTTPS or auth built in.
#RSSENHANCER_HOST=127.0.0.1
# Public base URL used for links in the feed (default http://127.0.0.1:PORT)
#RSSENHANCER_PUBLIC_URL=
# Default title is "Mail: " + the masked address (f***+bar@b***.com)
#SUBSCRIPTION_FEED_TITLE=
# rss (default) or atom: the format the mail feed is published in
#SUBSCRIPTION_FEED_FORMAT=rss

# Topic filters: topics are dropped right after the email is split, before any summary (so no AI call is spent on them).
# Keywords are matched against the topic's title, ignoring case, as whole words:
#   sponsor     the word sponsor (not "Sponsored")        sponsor*    any word starting with it: Sponsored, Sponsorship
#   *sponsor*   anywhere inside a word                    read more   a phrase
#   /^re:/i     a regular expression (use the file if it contains a comma)
SUBSCRIPTION_SKIP_KEYWORDS=sponsor*, advertisement
# The same, one per line, ! starts a comment. A relative path is relative to this folder.
#SUBSCRIPTION_SKIP_KEYWORDS_FILE=skip-keywords.txt
# Topics with fewer words than this are dropped (0 = off)
#SUBSCRIPTION_MIN_TOPIC_WORDS=0
#RSSENHANCER_ACCESS_LOG=1
# Default: ~/Library/Application Support/RssEnhancer  (keep on persistent storage when hosting)
#RSSENHANCER_DIR=
# Where the hydrator's feed list lives (default: config.json in the project folder)
#RSSENHANCER_CONFIG=

# ---------------------------------------------------------------- subscription processor: summaries
# A retelling (not a gist), sized by two limits (in words):
#   topic shorter than the first limit        -> no summary
#   first limit .. second limit               -> a summary the size of the first limit
#   topic longer than the second limit        -> first limit * FACTOR (half), to rein in big topics
#SUMMARY_LIMIT_WORDS=500
#SUMMARY_LONG_WORDS=1000
#SUMMARY_FACTOR=0.5
# Optional extra cap: summary at most this fraction of its topic (0 = off), e.g. 0.5
#SUMMARY_RATIO=0

# ---------------------------------------------------------------- subscription processor: AI provider
# anthropic | gemini | openai | deepseek | local | rapid-mlx
# If empty: the first key found below is used; with no keys but rapid-mlx installed, rapid-mlx is used.
AI_PROVIDER=

# anthropic (either key works; AUTH_TOKEN is sent as a Bearer token)
#ANTHROPIC_API_KEY=
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#ANTHROPIC_MODEL=claude-haiku-5-5

# gemini
# GOOGLE_API_KEY is accepted as an alias
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash

# openai
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini

# deepseek
#DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#DEEPSEEK_MODEL=deepseek-chat

# local and rapid-mlx share ONE endpoint, so a model server that something else already runs
# there is reused. Point this at wherever your other tools put theirs (mlx_lm.server: :8080).
#LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# Model to start (rapid-mlx) / to prefer (an already-running server with another model is used as is)
#LOCAL_MODEL=mlx-community/Qwen3.6-35B-A3B-5bit
# What to do when the endpoint already serves a different model: use (default) or fail
#LOCAL_ON_MISMATCH=use
#LOCAL_API_KEY=
# JSON merged into each request, e.g. {"chat_template_kwargs":{"enable_thinking":false}}
#LOCAL_EXTRA_BODY=

# AI_PROVIDER=local never starts anything. AI_PROVIDER=rapid-mlx starts `rapid-mlx serve` at
# LOCAL_BASE_URL when nothing answers, only when an email needs processing, and stops it after the poll.
#RAPID_MLX_BIN=
# Extra `serve` flags, e.g. --no-mllm
#RAPID_MLX_ARGS=
#RAPID_MLX_STARTUP_SECONDS=900
# 0 = keep the server running between polls
#RAPID_MLX_STOP_AFTER_POLL=1
